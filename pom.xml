<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>dev.twme</groupId>
    <artifactId>Sculpt</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>Sculpt</name>
    <description>A block sculpting plugin for Paper servers.</description>
    <url>https://github.com/TWME-TW/Sculpt</url>
    <organization>
        <name>TWME-TW</name>
        <url>https://github.com/TWME-TW</url>
    </organization>
    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Library versions (see DEVELOPMENT_PLAN.md §8) -->
        <mineskin.version>3.2.6-SNAPSHOT</mineskin.version>
        <gson.version>2.11.0</gson.version>
        <caffeine.version>3.1.8</caffeine.version>
        <sqlite.version>3.53.2.1</sqlite.version>
        <joml.version>1.10.8</joml.version>
        <worldedit.version>7.4.1</worldedit.version>
        <textdisplayshapes.version>3.0.0</textdisplayshapes.version>

        <!-- Test dependencies -->
        <junit.version>5.11.3</junit.version>
    </properties>

    <repositories>
        <repository>
            <id>papermc-repo</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
        <repository>
            <id>enginehub-repo</id>
            <url>https://maven.enginehub.org/repo/</url>
        </repository>
        <repository>
            <id>twme-releases</id>
            <url>https://repo.twme.dev/releases</url>
        </repository>
        <!--
            MineSkin java-client is published by InventivetalentDev to their own
            Sonatype repositories. Required for the org.mineskin:java-client
            coordinates used by the skin upload pipeline (Phase 3).
        -->
        <repository>
            <id>inventivetalent-public</id>
            <url>https://repo.inventivetalent.org/repository/public/</url>
        </repository>
        <repository>
            <id>inventivetalent-snapshots</id>
            <url>https://repo.inventivetalent.org/repository/snapshots/</url>
        </repository>
    </repositories>

    <dependencies>
        <!-- Paper API: provided by the server at runtime -->
        <dependency>
            <groupId>io.papermc.paper</groupId>
            <artifactId>paper-api</artifactId>
            <version>1.21.11-R0.1-SNAPSHOT</version>
            <scope>provided</scope>
        </dependency>

        <!-- MineSkin java-client (+ jsoup HTML parser variant): shaded into the plugin jar -->
        <dependency>
            <groupId>org.mineskin</groupId>
            <artifactId>java-client</artifactId>
            <version>${mineskin.version}</version>
        </dependency>
        <dependency>
            <groupId>org.mineskin</groupId>
            <artifactId>java-client-jsoup</artifactId>
            <version>${mineskin.version}</version>
        </dependency>

        <!-- Gson: shaded into the plugin jar -->
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>${gson.version}</version>
        </dependency>

        <!-- Caffeine cache: shaded into the plugin jar -->
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
            <version>${caffeine.version}</version>
        </dependency>

        <!-- SQLite runtime head cache: downloaded by Paper's plugin library loader. -->
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>${sqlite.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- WorldEdit API: provided by the server at runtime (WE or FAWE). -->
        <dependency>
            <groupId>com.sk89q.worldedit</groupId>
            <artifactId>worldedit-core</artifactId>
            <version>${worldedit.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- JOML: bundled by Paper at runtime, so provided scope is correct. -->
        <dependency>
            <groupId>org.joml</groupId>
            <artifactId>joml</artifactId>
            <version>${joml.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- TextDisplay pixel-plane geometry; shaded into Sculpt. -->
        <dependency>
            <groupId>dev.twme</groupId>
            <artifactId>textdisplayshape-paper</artifactId>
            <version>${textdisplayshapes.version}</version>
        </dependency>

        <!-- JUnit 5 (test scope only) -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <defaultGoal>clean package</defaultGoal>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <excludes>
                    <!-- SBH catalogs are installed by administrators, never bundled. -->
                    <exclude>*.sbh</exclude>
                    <exclude>*.bin</exclude>
                </excludes>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
                <includes>
                    <include>*.bin</include>
                </includes>
            </resource>
            <resource>
                <directory>${project.basedir}</directory>
                <targetPath>META-INF</targetPath>
                <filtering>false</filtering>
                <includes>
                    <include>LICENSE</include>
                    <include>NOTICE</include>
                </includes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <source>${java.version}</source>
                    <target>${java.version}</target>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.3</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <relocations>
                                <relocation>
                                    <pattern>org.mineskin</pattern>
                                    <shadedPattern>dev.twme.sculpt.shaded.mineskin</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>org.jsoup</pattern>
                                    <shadedPattern>dev.twme.sculpt.shaded.jsoup</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>com.github.benmanes.caffeine</pattern>
                                    <shadedPattern>dev.twme.sculpt.shaded.caffeine</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>com.google.gson</pattern>
                                    <shadedPattern>dev.twme.sculpt.shaded.gson</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>com.google.common</pattern>
                                    <shadedPattern>dev.twme.sculpt.shaded.guava</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>dev.twme.textdisplayshape</pattern>
                                    <shadedPattern>dev.twme.sculpt.shaded.textdisplayshape</shadedPattern>
                                </relocation>
                            </relocations>
                            <artifactSet>
                                <excludes>
                                    <exclude>org.checkerframework:*</exclude>
                                    <exclude>com.google.errorprone:*</exclude>
                                    <exclude>com.google.code.findbugs:*</exclude>
                                    <exclude>com.google.j2objc:*</exclude>
                                    <exclude>com.google.guava:listenablefuture</exclude>
                                </excludes>
                            </artifactSet>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>module-info.class</exclude>
                                        <exclude>META-INF/versions/**</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <configuration>
                    <classpathScope>compile</classpathScope>
                    <!-- BakeMain writes only the plugin's SQLite runtime cache;
                         administrator-supplied SBH catalogs are read-only. -->
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
